NODE_ENV=development
PORT=3000
APP_BASE_URL=https://your-coolify-domain.example
APP_TIME_ZONE=America/Chicago
DATA_DIR=/app/data
SKIP_PRISMA_MIGRATE=false
PRISMA_BASELINE_EXISTING_DB=true
PRISMA_QUERY_LOG=false
PRISMA_HIDE_UPDATE_MESSAGE=1

# Web UI login. In production ADMIN_PASSWORD is required.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-long-random-secret

# Postgres. Coolify can provide DATABASE_URL.
DATABASE_URL=postgres://ftr:ftr@postgres:5432/ftr_fix_bot

# Telegram. Rotate any token that was shared outside your private secrets store.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_JOB_CHAT_TITLE=FTRFIXBOT_CHAT
TELEGRAM_JOB_CHAT_ID=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_ACK_ENABLED=true
TELEGRAM_ADMIN_USER_IDS=

# BlueBubbles.
BLUEBUBBLES_SERVER_URL=https://your-bluebubbles-server.example
BLUEBUBBLES_PASSWORD=replace-with-bluebubbles-password
BLUEBUBBLES_WEBHOOK_SECRET=change-this-webhook-secret
BLUEBUBBLES_SEND_METHOD=private-api
BLUEBUBBLES_SERVICE_ORDER=iMessage,SMS
BLUEBUBBLES_ADDRESS_FALLBACK=true
BLUEBUBBLES_TYPING_INDICATORS_ENABLED=true
BLUEBUBBLES_ESCALATION_ENABLED=false
BLUEBUBBLES_ESCALATION_PHONES=
BLUEBUBBLES_ESCALATION_TEMPLATE=

# Agent.
LLM_PROVIDER=ollama
CLASSIFICATION_MODE=ai_only
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AUTO_SEND_FOLLOWUP=true
FOLLOWUP_MAX_AGENT_MESSAGES=6
FOLLOWUP_CONVERSATION_WINDOW_DAYS=30
FOLLOWUP_REPLY_DELAY_MIN_SECONDS=5
FOLLOWUP_REPLY_DELAY_MAX_SECONDS=10
